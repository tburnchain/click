# ─────────────────────────────────────────────────────────────
# GAMDAP 환경설정 예시 — 복사해서 `.env` 로 사용
# 실제 비밀키는 절대 커밋하지 말 것 (프로덕션은 Vault/SSM 시크릿매니저 사용)
# ─────────────────────────────────────────────────────────────

# --- 실행 환경 ---
GAMDAP_ENV=development                # development | staging | production
GAMDAP_LOG_LEVEL=INFO                 # DEBUG | INFO | WARNING | ERROR
GAMDAP_LOG_JSON=false                 # 프로덕션은 true (구조화 로그)

# --- PostgreSQL ---
GAMDAP_DB_HOST=localhost
GAMDAP_DB_PORT=5432
GAMDAP_DB_NAME=gamdap
GAMDAP_DB_USER=gamdap
GAMDAP_DB_PASSWORD=changeme
GAMDAP_DB_POOL_MIN=2
GAMDAP_DB_POOL_MAX=10

# --- Redis (캐시/큐) ---
GAMDAP_REDIS_URL=redis://localhost:6379/0

# --- 기준통화 ---
GAMDAP_BASE_CURRENCY=KRW

# --- 쿠팡 파트너스 OpenAPI (M1) ---
# 발급: 쿠팡 파트너스 → API 관리에서 ACCESS/SECRET 키 발급
GAMDAP_COUPANG_ACCESS_KEY=
GAMDAP_COUPANG_SECRET_KEY=
GAMDAP_COUPANG_SUBID=                 # 선택: 채널/트래킹 subId
GAMDAP_COUPANG_BASE_URL=https://api-gateway.coupang.com

# --- CJ Affiliate (애그리게이터, M5) ---
GAMDAP_CJ_TOKEN=                      # Developer Portal Personal Access Token
GAMDAP_CJ_COMPANY_ID=                 # publisher company id
GAMDAP_CJ_WEBSITE_ID=                 # PID / website id
GAMDAP_CJ_BASE_URL=https://ads.api.cj.com

# --- Impact (애그리게이터, M5) ---
GAMDAP_IMPACT_ACCOUNT_SID=
GAMDAP_IMPACT_AUTH_TOKEN=
GAMDAP_IMPACT_CATALOG_ID=
GAMDAP_IMPACT_BASE_URL=https://api.impact.com

# --- 환율 소스 (선택, 없으면 rate=1 폴백) ---
GAMDAP_FX_PROVIDER=ecb                # ecb | manual | koreaexim
GAMDAP_FX_API_KEY=
